#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// --------------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   ß-S  | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Z   |  U    |  I    |  O   |   P   |   Ü   | ENTER |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   Ö   |   Ä   |   #   |
// |  CTRl |  Y  |  X  |  C   |  V   |  B   |                   |  N   |  M    |  ,    |  .   |   -   | SHIFT |  DEL  |
//                     | ALT  | GUI  | LOWER|  SPACE |  | SHIFT | RAISE| BSPC  | UPER  |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                       &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp S     &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                        &kp Z  &kp U    &kp I     &kp O   &kp P    &kp U     &kp RET
&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G                        &kp H  &kp J    &kp K     &kp L   &kp O    &kp A     &kp HASH
&kp LCTRL &kp Y  &kp X  &kp C    &kp V    &kp B                        &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RALT  &kp DELETE 
                        &kp LALT &kp LGUI &mo 1  &kp SPACE  &kp RSHFT  &mo 1  &kp BSPC &mo 2 
            >;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |       |
// |       |     |  1  |  2   |   3  |   +  |                   |      |       |  ^    |      |       |       |       |
// |       |     |  4  |  5   |   6  |   -  |                   |      |  <-   |  v    |  ->  |       |       |       |
// |       |     |  7  |  8   |   9  |   /  |                   |      |       |       |      |       |       |       |
//                     |  0   |   *  |      |        |  |       |      |       |       |
            bindings = <
&bt BT_CLR &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3 &bt BT_SEL 4                 &trans    &trans    &trans    &trans    &trans    &trans   &trans
&trans     &trans        &kp N1        &kp N2         &kp N3       &kp APOS                     &trans    &trans    &kp UP    &trans    &trans    &trans   &trans
&trans     &trans        &kp N4        &kp N5         &kp N6       &kp SLASH                    &trans    &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans   &trans
&trans     &trans        &kp N7        &kp N8         &kp N9       &kp QUESTION                 &trans    &trans    &trans    &trans    &trans    &trans   &trans
                                       &kp N0         &kp ASTRK    &trans    &trans   &trans    &trans    &trans    &trans
            >;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |  F1   | F2  |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |   F9  |  F10 |  F11  |  F12  |       |
// |   ^   |  @  |     |  €   |      |      |                   |      |       |  pgup |      |       |       |       |
// |       |     |     |      |      |      |                   |      |       |  pgdwn|      |       |       |       |
// |       |  <  |     |      |      |      |                   |      |       |       |      |       |       |       |
//                     |      |      |      |        |  |       |      |       |       |
            bindings = <
&kp F1    &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                     &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &trans
&kp CARET &kp AT  &trans  &trans  &trans  &trans                     &trans    &trans    &kp PG_UP &trans    &trans    &trans    &trans
&trans    &trans  &trans  &trans  &trans  &trans                     &trans    &trans    &kp PG_DN &trans    &trans    &trans    &trans
&trans    &kp LT  &trans  &trans  &trans  &trans                     &trans    &trans    &trans    &trans    &trans    &trans    &trans
                  &trans  &trans  &trans  &trans   &trans    &trans  &trans    &trans
            >;
        };
    };
};